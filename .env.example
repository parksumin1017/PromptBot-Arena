# GitHub Personal Access Token (PAT)
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=your_username_here

# LLM Provider Configuration ('postech', 'openai', 'gemini', 'mock')
LLM_PROVIDER=postech
POSTECH_API_KEY=your_postech_api_key_here
POSTECH_MODEL_TYPE=gemini  # 'gpt', 'gemini', 'claude'

# Official Keys (for future migration)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
